  "dependencies": {
    "exceljs": "4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
